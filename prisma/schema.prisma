generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  SCHOOL_ADMIN
}

enum PositionType {
  SPIN
  TRICK
  TRANSITION
  WARMUP
  STRENGTH
}

enum PositionLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MediaKind {
  PHOTO
  VIDEO
}

enum LearningStatus {
  NOT_STARTED
  IN_PROGRESS
  PASSED
  MASTERED
}

enum MasteryLevel {
  INITIATED
  PASSED
  FLUID
  CHOREO
}

enum GameMode {
  PHOTO_NAME
  NAME_TYPE
  NAME_LEVEL
  NAME_GRIPS
  DESCRIPTION_NAME
  BLITZ_MIX
}

enum InvoiceStatus {
  GENERATED
  SENT
  PAID
  LATE
  CANCELLED
}

model School {
  id        String   @id @default(cuid())
  name      String
  website   String?
  photoUrl  String?
  createdAt DateTime @default(now())

  users    User[]
  courses  Course[]
  studios  Studio[]
  partners Partner[]
  gameSessions GameSession[]

  @@unique([name])
}

model User {
  id            String                    @id @default(cuid())
  email         String                    @unique
  name          String?
  age           Int?
  avatarUrl     String?
  diplomas      String?
  passwordHash  String
  role          Role
  credits       Int                       @default(0)
  schoolId      String?
  isPremium     Boolean                   @default(false)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  school        School?                   @relation(fields: [schoolId], references: [id])
  injuries      StudentInjury[]
  progress      StudentPositionProgress[]
  courseNotes   CourseNote[]
  attendances   CourseAttendance[]
  coursesTaught Course[]                  @relation("CourseTeacher")
  favoritePositions TeacherFavoritePosition[]
  studentFavoritePositions StudentFavoritePosition[]
  gameSessions     GameSession[]
  partnerEvents    PartnerEvent[]

  createdPositions    Position[]                @relation("CreatedPositions")
  lastUpdatedProgress StudentPositionProgress[] @relation("ProgressUpdatedBy")

  @@index([role, isPremium])
  @@index([email])
  @@index([name])
}

model Position {
  id                String        @id @default(cuid())
  name              String
  description       String?
  levelRequired     PositionLevel
  type              PositionType
  grips             String?
  tips              String?
  contraindications String?
  createdByUserId   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  createdBy         User?         @relation("CreatedPositions", fields: [createdByUserId], references: [id])

  media         PositionMedia[]
  progress      StudentPositionProgress[]
  courseEntries CoursePosition[]
  courseNotes   CourseNote[]
  favoriteByTeachers TeacherFavoritePosition[]
  favoriteByStudents StudentFavoritePosition[]
  recommendations CourseRecommendation[]

  @@unique([name])
}

model PositionMedia {
  id         String    @id @default(cuid())
  positionId String
  kind       MediaKind
  url        String
  createdAt  DateTime  @default(now())
  position   Position  @relation(fields: [positionId], references: [id])
}

model InjuryType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  studentInjuries StudentInjury[]
}

model StudentInjury {
  id           String     @id @default(cuid())
  studentId    String
  injuryTypeId String
  notes        String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  student      User       @relation(fields: [studentId], references: [id])
  injuryType   InjuryType @relation(fields: [injuryTypeId], references: [id])
}

model StudentPositionProgress {
  id                  String         @id @default(cuid())
  studentId           String
  positionId          String
  learningStatus      LearningStatus
  masteryLevel        MasteryLevel?
  comment             String?
  lastUpdatedByUserId String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  student             User           @relation(fields: [studentId], references: [id])
  position            Position       @relation(fields: [positionId], references: [id])
  lastUpdatedBy       User?          @relation("ProgressUpdatedBy", fields: [lastUpdatedByUserId], references: [id])

  @@unique([studentId, positionId])
}

model Course {
  id              String   @id @default(cuid())
  schoolId        String
  teacherId       String
  studioId        String?
  title           String?
  photoUrl        String?
  date            DateTime
  durationMinutes Int      @default(60)
  maxSeats        Int      @default(30)
  costCredits     Int      @default(100)
  createdAt       DateTime @default(now())
  school          School   @relation(fields: [schoolId], references: [id])
  teacher         User     @relation("CourseTeacher", fields: [teacherId], references: [id])
  studio          Studio?  @relation(fields: [studioId], references: [id])

  attendances CourseAttendance[]
  positions   CoursePosition[]
  notes       CourseNote[]
  recommendations CourseRecommendation[]
  invoices    Invoice[]
  partnerEvents PartnerEvent[]

  @@index([schoolId, date])
  @@index([teacherId])
  @@index([studioId])
}

model CourseAttendance {
  id           String            @id @default(cuid())
  courseId     String
  studentId    String
  status       AttendanceStatus  @default(CONFIRMED)
  waitlistRank Int?
  createdAt    DateTime          @default(now())
  course       Course            @relation(fields: [courseId], references: [id])
  student      User              @relation(fields: [studentId], references: [id])

  @@unique([courseId, studentId])
}

enum AttendanceStatus {
  CONFIRMED
  WAITLIST
}

enum SuggestionTag {
  DISCOVERY
  REVISION
  SAFE
}

enum PartnerEventType {
  CLICK
  PURCHASE
}

model CoursePosition {
  id         String   @id @default(cuid())
  courseId   String
  positionId String
  course     Course   @relation(fields: [courseId], references: [id])
  position   Position @relation(fields: [positionId], references: [id])

  @@unique([courseId, positionId])
}

model CourseNote {
  id           String       @id @default(cuid())
  courseId     String
  studentId    String
  positionId   String
  masteryLevel MasteryLevel
  comment      String?
  createdAt    DateTime     @default(now())
  course       Course       @relation(fields: [courseId], references: [id])
  student      User         @relation(fields: [studentId], references: [id])
  position     Position     @relation(fields: [positionId], references: [id])

  @@unique([courseId, studentId, positionId])
}

model Studio {
  id        String   @id @default(cuid())
  name      String
  address   String?
  photoUrl  String?
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id])
  courses   Course[]
  partnerEvents PartnerEvent[]

  @@index([schoolId])
}

model Partner {
  id             String          @id @default(cuid())
  name           String
  kind           String          @default("SERVICE")
  website        String?
  description    String?
  schoolId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  school         School          @relation(fields: [schoolId], references: [id])
  sponsoredLinks SponsoredLink[]
  events         PartnerEvent[]

  @@index([schoolId])
}

model SponsoredLink {
  id        String   @id @default(cuid())
  category  String
  label     String?
  url       String
  partnerId String
  createdAt DateTime @default(now())
  partner   Partner  @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
}

model PartnerEvent {
  id        String           @id @default(cuid())
  partnerId String
  userId    String?
  courseId  String?
  studioId  String?
  type      PartnerEventType @default(CLICK)
  createdAt DateTime         @default(now())

  partner Partner @relation(fields: [partnerId], references: [id])
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  course  Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  studio  Studio? @relation(fields: [studioId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([userId])
  @@index([courseId])
  @@index([studioId])
}

model TeacherFavoritePosition {
  id         String   @id @default(cuid())
  teacherId  String
  positionId String
  teacher    User     @relation(fields: [teacherId], references: [id])
  position   Position @relation(fields: [positionId], references: [id])

  @@unique([teacherId, positionId])
  @@index([teacherId])
  @@index([positionId])
}

model StudentFavoritePosition {
  id         String   @id @default(cuid())
  studentId  String
  positionId String
  student    User     @relation(fields: [studentId], references: [id])
  position   Position @relation(fields: [positionId], references: [id])

  @@unique([studentId, positionId])
  @@index([studentId])
  @@index([positionId])
}

model CourseRecommendation {
  id         String        @id @default(cuid())
  courseId   String
  positionId String
  tag        SuggestionTag
  reason     String?
  appliedAt  DateTime?
  createdAt  DateTime      @default(now())
  course     Course        @relation(fields: [courseId], references: [id])
  position   Position      @relation(fields: [positionId], references: [id])

  @@unique([courseId, positionId])
  @@index([courseId])
}

model GameSession {
  id             String    @id @default(cuid())
  userId         String
  schoolId       String?
  mode           GameMode
  totalQuestions Int
  correctAnswers Int
  durationMs     Int?
  createdAt      DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  school School? @relation(fields: [schoolId], references: [id])

  @@index([userId])
  @@index([schoolId])
  @@index([mode])
}

model Invoice {
  id          String        @id @default(cuid())
  courseId    String        @unique
  amountCents Int
  currency    String        @default("EUR")
  status      InvoiceStatus @default(GENERATED)
  issuedAt    DateTime      @default(now())
  paidAt      DateTime?
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  course      Course        @relation(fields: [courseId], references: [id])

  @@index([status])
  @@index([issuedAt])
}
