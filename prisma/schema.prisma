generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  SUPER_ADMIN
  SCHOOL_ADMIN
}

enum PositionType {
  SPIN
  TRICK
  TRANSITION
  WARMUP
  STRENGTH
}

enum PositionLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MediaKind {
  PHOTO
  VIDEO
}

enum LearningStatus {
  NOT_STARTED
  IN_PROGRESS
  PASSED
  MASTERED
}

enum GameMode {
  PHOTO_NAME
  NAME_TYPE
  NAME_LEVEL
  NAME_GRIPS
  DESCRIPTION_NAME
  BLITZ_MIX
}

enum InvoiceStatus {
  GENERATED
  SENT
  PAID
  LATE
  CANCELLED
  REFUNDED
}

enum ManualFinancialStatus {
  NONE
  PAID
  LATE
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model School {
  id        String   @id @default(cuid())
  name      String
  website   String?
  photoUrl  String?
  createdAt DateTime @default(now())
  archivedAt DateTime?

  users    User[]
  courses  Course[]
  studios  Studio[]
  partners Partner[]
  gameSessions GameSession[]
  presets  Preset[]
  recurrenceSeries CourseRecurrenceSeries[]

  @@unique([name])
}

model Discipline {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#7c3aed")
  createdAt DateTime @default(now())

  positions Position[]
  courses   Course[]
  presets   Preset[]

  @@unique([name])
}

model User {
  id            String                    @id @default(cuid())
  email         String                    @unique
  name          String?
  age           Int?
  avatarUrl     String?
  avatarPublicId String?
  diplomas      String?
  passwordHash  String
  role          Role
  credits       Int                       @default(0)
  schoolId      String?
  isPremium     Boolean                   @default(false)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  school        School?                   @relation(fields: [schoolId], references: [id])
  injuries      StudentInjury[]
  progress      StudentPositionProgress[]
  courseNotes   CourseNote[]
  attendances   CourseAttendance[]
  coursesTaught Course[]                  @relation("CourseTeacher")
  favoritePositions TeacherFavoritePosition[]
  studentFavoritePositions StudentFavoritePosition[]
  gameSessions     GameSession[]
  partnerEvents    PartnerEvent[]
  purchases        Purchase[]
  createdPresets   Preset[]
  manualSetInvoices Invoice[] @relation("InvoiceManualSetBy")
  refundedInvoices  Invoice[] @relation("InvoiceRefundedBy")
  recurrenceSeries  CourseRecurrenceSeries[]

  createdPositions    Position[]                @relation("CreatedPositions")
  lastUpdatedProgress StudentPositionProgress[] @relation("ProgressUpdatedBy")
  auditLogs          AuditLog[]

  @@index([role, isPremium])
  @@index([email])
  @@index([name])
}

model Position {
  id                String        @id @default(cuid())
  name              String
  description       String?
  levelRequired     PositionLevel
  type              PositionType
  discipline        String?
  disciplineId      String
  grips             String?
  tips              String?
  contraindications String?
  createdByUserId   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  createdBy         User?         @relation("CreatedPositions", fields: [createdByUserId], references: [id])
  disciplineRef     Discipline?   @relation(fields: [disciplineId], references: [id])

  media         PositionMedia[]
  progress      StudentPositionProgress[]
  courseEntries CoursePosition[]
  courseNotes   CourseNote[]
  favoriteByTeachers TeacherFavoritePosition[]
  favoriteByStudents StudentFavoritePosition[]
  recommendations CourseRecommendation[]
  muscles       PositionTarget[]
  presetLinks   PresetPosition[]

  @@unique([name])
  @@index([disciplineId])
}

model Muscle {
  id        String   @id @default(cuid())
  name      String   @unique
  kind      String   @default("MUSCLE") // MUSCLE | ARTICULATION | OTHER
  createdAt DateTime @default(now())

  positions PositionTarget[]
}

model PositionTarget {
  positionId String
  muscleId   String
  createdAt  DateTime @default(now())

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  muscle   Muscle   @relation(fields: [muscleId], references: [id], onDelete: Cascade)

  @@id([positionId, muscleId])
}

model PositionMedia {
  id         String    @id @default(cuid())
  positionId String
  kind       MediaKind
  publicId   String
  createdAt  DateTime  @default(now())
  position   Position  @relation(fields: [positionId], references: [id])
}

model InjuryType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  studentInjuries StudentInjury[]
}

model StudentInjury {
  id           String     @id @default(cuid())
  studentId    String
  injuryTypeId String
  notes        String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  student      User       @relation(fields: [studentId], references: [id])
  injuryType   InjuryType @relation(fields: [injuryTypeId], references: [id])
}

model StudentPositionProgress {
  id                  String         @id @default(cuid())
  studentId           String
  positionId          String
  learningStatus      LearningStatus
  comment             String?
  lastUpdatedByUserId String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  student             User           @relation(fields: [studentId], references: [id])
  position            Position       @relation(fields: [positionId], references: [id])
  lastUpdatedBy       User?          @relation("ProgressUpdatedBy", fields: [lastUpdatedByUserId], references: [id])

  @@unique([studentId, positionId])
}

model Course {
  id              String   @id @default(cuid())
  schoolId        String
  teacherId       String
  studioId        String?
  title           String?
  discipline      String?
  disciplineId    String
  photoUrl        String?
  date            DateTime
  durationMinutes Int      @default(60)
  maxSeats        Int      @default(30)
  costCredits     Int      @default(100)
  waitlistQuota   Int      @default(0)
  createdAt       DateTime @default(now())
  school          School   @relation(fields: [schoolId], references: [id])
  teacher         User     @relation("CourseTeacher", fields: [teacherId], references: [id])
  studio          Studio?  @relation(fields: [studioId], references: [id])

  attendances CourseAttendance[]
  positions   CoursePosition[]
  notes       CourseNote[]
  recommendations CourseRecommendation[]
  invoices    Invoice[]
  partnerEvents PartnerEvent[]
  recurrenceSeriesId String?
  recurrenceSeries   CourseRecurrenceSeries? @relation(fields: [recurrenceSeriesId], references: [id])
  isVirtual    Boolean  @default(false)
  disciplineRef Discipline? @relation(fields: [disciplineId], references: [id])

  @@index([schoolId, date])
  @@index([teacherId])
  @@index([studioId])
  @@index([disciplineId])
}

model CourseAttendance {
  id           String            @id @default(cuid())
  courseId     String
  studentId    String
  status       AttendanceStatus  @default(CONFIRMED)
  waitlistRank Int?
  createdAt    DateTime          @default(now())
  course       Course            @relation(fields: [courseId], references: [id])
  student      User              @relation(fields: [studentId], references: [id])

  @@unique([courseId, studentId])
}

enum AttendanceStatus {
  CONFIRMED
  WAITLIST
}

enum SuggestionTag {
  DISCOVERY
  REVISION
  SAFE
}

enum PartnerEventType {
  CLICK
  PURCHASE
}

model CoursePosition {
  id         String   @id @default(cuid())
  courseId   String
  positionId String
  course     Course   @relation(fields: [courseId], references: [id])
  position   Position @relation(fields: [positionId], references: [id])

  @@unique([courseId, positionId])
}

model CourseNote {
  id           String       @id @default(cuid())
  courseId     String
  studentId    String
  positionId   String
  learningStatus LearningStatus?
  comment      String?
  createdAt    DateTime     @default(now())
  course       Course       @relation(fields: [courseId], references: [id])
  student      User         @relation(fields: [studentId], references: [id])
  position     Position     @relation(fields: [positionId], references: [id])

  @@unique([courseId, studentId, positionId])
}

model Studio {
  id        String   @id @default(cuid())
  name      String
  address   String?
  photoUrl  String?
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id])
  courses   Course[]
  partnerEvents PartnerEvent[]

  @@index([schoolId])
}

model Partner {
  id             String          @id @default(cuid())
  name           String
  kind           String          @default("SERVICE")
  website        String?
  description    String?
  schoolId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  school         School          @relation(fields: [schoolId], references: [id])
  sponsoredLinks SponsoredLink[]
  events         PartnerEvent[]

  @@index([schoolId])
  @@index([schoolId, kind])
}

model SponsoredLink {
  id        String   @id @default(cuid())
  category  String
  label     String?
  url       String
  partnerId String
  createdAt DateTime @default(now())
  partner   Partner  @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
}

model PartnerEvent {
  id        String           @id @default(cuid())
  partnerId String
  userId    String?
  courseId  String?
  studioId  String?
  type      PartnerEventType @default(CLICK)
  createdAt DateTime         @default(now())

  partner Partner @relation(fields: [partnerId], references: [id])
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  course  Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  studio  Studio? @relation(fields: [studioId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([userId])
  @@index([courseId])
  @@index([studioId])
  @@index([partnerId, createdAt])
}

model TeacherFavoritePosition {
  id         String   @id @default(cuid())
  teacherId  String
  positionId String
  teacher    User     @relation(fields: [teacherId], references: [id])
  position   Position @relation(fields: [positionId], references: [id])

  @@unique([teacherId, positionId])
  @@index([teacherId])
  @@index([positionId])
}

model StudentFavoritePosition {
  id         String   @id @default(cuid())
  studentId  String
  positionId String
  student    User     @relation(fields: [studentId], references: [id])
  position   Position @relation(fields: [positionId], references: [id])

  @@unique([studentId, positionId])
  @@index([studentId])
  @@index([positionId])
}

model CourseRecommendation {
  id         String        @id @default(cuid())
  courseId   String
  positionId String
  tag        SuggestionTag
  reason     String?
  excludedForInjury Boolean @default(false)
  forced     Boolean   @default(false)
  appliedAt  DateTime?
  createdAt  DateTime      @default(now())
  course     Course        @relation(fields: [courseId], references: [id])
  position   Position      @relation(fields: [positionId], references: [id])

  @@unique([courseId, positionId])
  @@index([courseId])
}

model GameSession {
  id             String    @id @default(cuid())
  userId         String
  schoolId       String?
  mode           GameMode
  totalQuestions Int
  correctAnswers Int
  durationMs     Int?
  createdAt      DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  school School? @relation(fields: [schoolId], references: [id])

  @@index([userId])
  @@index([schoolId])
  @@index([mode])
}

model Invoice {
  id          String        @id @default(cuid())
  courseId    String        @unique
  amountCents Int
  currency    String        @default("EUR")
  status      InvoiceStatus @default(GENERATED)
  manualStatus ManualFinancialStatus @default(NONE)
  manualNote  String?
  manualSetById String?
  manualSetAt  DateTime?
  issuedAt    DateTime      @default(now())
  paidAt      DateTime?
  refundedAt  DateTime?
  refundedById String?
  refundNote  String?
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  course      Course        @relation(fields: [courseId], references: [id])
  manualSetBy User?         @relation("InvoiceManualSetBy", fields: [manualSetById], references: [id], onDelete: SetNull)
  refundedBy  User?         @relation("InvoiceRefundedBy", fields: [refundedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([manualStatus])
  @@index([issuedAt])
}

model GlobalSetting {
  id               String   @id @default("global")
  defaultVatPercent Int     @default(20)
  currency          String  @default("EUR")
  timezone          String  @default("Europe/Paris")
  icsDefaultAlarmMinutes Int @default(30)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CourseRecurrenceSeries {
  id         String              @id @default(cuid())
  schoolId   String
  teacherId  String
  frequency  RecurrenceFrequency
  until      DateTime
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  courses    Course[]

  school School @relation(fields: [schoolId], references: [id])
  teacher User  @relation(fields: [teacherId], references: [id])

  @@index([schoolId])
  @@index([teacherId])
}

model SubscriptionOffer {
  id                 String   @id @default(cuid())
  name               String
  monthlyPriceCents  Int
  annualPriceCents   Int
  monthlyCredits     Int      @default(1000)
  vatPercent         Int      @default(20)
  isActive           Boolean  @default(true)
  isOpen             Boolean  @default(true)
  sortOrder          Int      @default(0)
  defaultTerm        String?  // ex: MONTHLY | ANNUAL (souple pour itérations)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive, isOpen])
  @@index([sortOrder])
}

model CreditPackOffer {
  id           String   @id @default(cuid())
  name         String
  credits      Int
  priceCents   Int
  vatPercent   Int      @default(20)
  isActive     Boolean  @default(true)
  isOpen       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, isOpen])
  @@index([sortOrder])
}

model Purchase {
  id               String   @id @default(cuid())
  userId           String
  offerId          String
  offerName        String
  kind             String   // PACK | SUBSCRIPTION | PRESET
  amountCents      Int
  vatPercent       Int      @default(20)
  currency         String   @default("EUR")
  creditsGranted   Int      @default(0)
  isPremiumGranted Boolean  @default(false)
  status           String   @default("PAID")
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([kind, status])
}

model Preset {
  id               String    @id @default(cuid())
  schoolId         String
  createdByUserId  String?
  title            String
  description      String?
  discipline       String?
  disciplineId     String
  videoPublicId    String?
  imagePublicId    String?
  premiumRequired  Boolean   @default(false)
  priceCredits     Int?
  usageCount       Int       @default(0)
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  positions        PresetPosition[]
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy        User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  disciplineRef    Discipline? @relation(fields: [disciplineId], references: [id])

  @@index([schoolId])
  @@index([disciplineId])
}

model PresetPosition {
  presetId   String
  positionId String
  preset     Preset   @relation(fields: [presetId], references: [id], onDelete: Cascade)
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@id([presetId, positionId])
}

model AuditLog {
  id        String    @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  details   Json?
  createdAt DateTime  @default(now())
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
}
