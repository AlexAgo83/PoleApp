DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/poleapp?schema=public"
NEXTAUTH_SECRET="change-me-dev-secret"
NEXTAUTH_URL="http://localhost:3000"
DATABASE_SEED_PWD="poleapp123" # mot de passe seed pour les comptes fixtures

RESEND_API_KEY=
# SMTP (reset mail)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ENABLE_EMAIL_RESET=true
EMAIL_FROM=<expéditeur_validé_chez_Brevo>

# Cloudinary (uploads médias)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AVATAR_DEFAULT_IDS= # liste de public_id séparés par des virgules
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Super admin seed (obligatoire en prod)
SUPER_ADMIN_EMAIL=superadmin@poleapp.test
SUPER_ADMIN_PASSWORD=poleapp123

# Accès prod Render (utilisation ops uniquement, ne pas renseigner en dev/local si inutile)
PROD_RENDER_DATABASE_URL="EXTERNAL=postgresql://USER:PASSWORD@HOST:5432/DBNAME"
PROD_RENDER_PSQL_COMMAND="PGPASSWORD=PASSWORD psql -h HOST -U USER DBNAME"
