DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/poleapp?schema=poleapp" # each app uses its own dedicated schema
NEXTAUTH_SECRET="change-me-dev-secret"
NEXTAUTH_URL="http://localhost:3000"
DATABASE_SEED_PWD="change-me-password" # seed password for fixture accounts

RESEND_API_KEY=
# SMTP (reset mail)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ENABLE_EMAIL_RESET=true
EMAIL_FROM=<validated_sender_at_Brevo>

# Cloudinary (media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AVATAR_DEFAULT_IDS= # comma-separated list of public_id values
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Super admin seed (required in production)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Render production access (ops-only, do not set in local/dev unless needed)
PROD_RENDER_DATABASE_URL="EXTERNAL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=poleapp"
PROD_RENDER_PSQL_COMMAND="PGPASSWORD=PASSWORD psql -h HOST -U USER DBNAME"
